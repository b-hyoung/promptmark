<%-- Bundle thumbnail mockup. Renders a CSS-only "result preview" based on b.thumbnail key. --%>
<%-- Keys: mock:blog, mock:code, mock:design, mock:ad, mock:aiapp, mock:mvp --%>
<c:set var="mockKey" value="${fn:substringAfter(b.thumbnail, 'mock:')}"/>
<div class="bundle-mock bundle-mock-${mockKey}">
  <c:choose>
    <c:when test="${mockKey == 'blog'}">
      <div class="mock-chip">📝 BLOG · 28분 작성</div>
      <div class="mock-title">AI가 글을 쓰면 티가 난다.<br>그 티를 지우는 30분 워크플로</div>
      <div class="mock-meta"><span>★ 4.8</span><span>2,847 reads</span></div>
    </c:when>
    <c:when test="${mockKey == 'code'}">
      <div class="mock-chip">⚙ PR #247 · 12 files changed</div>
      <div class="mock-line mock-line-ok">✓ All checks passed</div>
      <div class="mock-line mock-line-warn">⚠ NPE 가능: userService.findById()</div>
      <div class="mock-line mock-line-info">🧹 parseConfig() 중복 — 삭제 가능</div>
    </c:when>
    <c:when test="${mockKey == 'design'}">
      <div class="mock-chip">🎨 컴포넌트 시스템 · 12개</div>
      <div class="mock-grid">
        <span class="mock-cell">Btn</span><span class="mock-cell">Card</span>
        <span class="mock-cell">Form</span><span class="mock-cell">Nav</span>
        <span class="mock-cell">Tab</span><span class="mock-cell">Modal</span>
      </div>
    </c:when>
    <c:when test="${mockKey == 'ad'}">
      <div class="mock-chip">📢 AD · CTR 4.8%</div>
      <div class="mock-headline">14시간 → 19분, 직접 확인하기</div>
      <div class="mock-sub">매달 인보이스에 14시간 쓰는 회계 담당자에게.</div>
      <div class="mock-cta">무료 체험 시작 →</div>
    </c:when>
    <c:when test="${mockKey == 'aiapp'}">
      <div class="mock-chip">🤖 CHAT · 토큰 -72%</div>
      <div class="mock-bubble mock-bubble-user">기술 인터뷰 질문 5개 만들어줘</div>
      <div class="mock-bubble mock-bubble-bot">React 상태 관리 관련으로...</div>
    </c:when>
    <c:when test="${mockKey == 'mvp'}">
      <div class="mock-chip">🚀 MVP · Day 7</div>
      <div class="mock-day"><span class="mock-day-num">1</span> 범위 결정 ✓</div>
      <div class="mock-day"><span class="mock-day-num">3</span> UI 컴포넌트 ✓</div>
      <div class="mock-day"><span class="mock-day-num">5</span> 카피 통합 ✓</div>
      <div class="mock-day mock-day-live"><span class="mock-day-num">7</span> 배포 🎉</div>
    </c:when>
    <c:otherwise>
      <div class="mock-chip">📦 BUNDLE</div>
      <div class="mock-title"><c:out value="${b.name}"/></div>
    </c:otherwise>
  </c:choose>
</div>
